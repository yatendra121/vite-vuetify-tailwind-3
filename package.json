{
  "name": "vite-vuetify-talwind-3",
  "version": "0.0.0",
  "scripts": {
    "dev": "node portalConfig && vite --host",
    "build": "node portalConfig && vue-tsc --noEmit && vite build",
    "build-force": "node portalConfig && vite build",
    "serve": "vite preview",
    "config-key-merge": "node portalConfig",
    "tsc": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:unit": "vitest",
    "test:e2e": "playwright test --ui",
    "test:e2e:run": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
